  <static seed="109" source="Library/272/setStewart14_3/problem_4.pg">
    <statement><p>Find the partial derivatives of the function
<me>f(x,y) = \int_y^x \cos(-8 t^2  - 5 t  - 6)\, dt</me></p>
<p><m>f_x(x,y) =</m><fillin characters="60" name="AnSwEr0001"/></p>
<p><m>f_y(x,y) =</m><fillin characters="60" name="AnSwEr0002"/></p>
</statement>
    <answer>
      <p>
        <m>\cos\mathopen{}\left(-8x^{2}+\left(-5\right)x+\left(-6\right)\right)</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>-\cos\mathopen{}\left(-8y^{2}+\left(-5\right)y+\left(-6\right)\right)</m>
      </p>
    </answer>
