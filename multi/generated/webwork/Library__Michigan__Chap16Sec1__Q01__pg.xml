    <statement><p>Values of <m>f(x,y)</m> are shown in the table below.</p>
<tabular bottom="medium" left="medium" right="medium" top="medium">
<row>
<cell> </cell>
<cell><m>x = 2</m></cell>
<cell><m>x = 2.3</m></cell>
<cell><m>x = 2.6</m></cell>
</row>
<row>
<cell><m>y = 4</m></cell>
<cell>9</cell>
<cell>11</cell>
<cell>15</cell>
</row>
<row>
<cell><m>y = 4.4</m></cell>
<cell>11</cell>
<cell>13</cell>
<cell>19</cell>
</row>
<row>
