<publication>
  <source>
    <version include="book online"/>
    <directories generated="../generated-assets" />
  </source>
  <latex sides="two" font-size="10" pageref="no">
    <worksheet formatted="no"/>
      <page>
        <geometry>paperwidth=7.44in,paperheight=9.69in,tmargin=.5in,bmargin=.3in,hmargin=.75in,bindingoffset=.4in,includeheadfoot,marginparsep=6ex</geometry>
      </page>
  </latex>
  <common>
    <!-- List Chapters and Sections in sidebar Table of Contents -->
    <tableofcontents level="2" />
    <exercise-inline />
    <exercise-divisional statement="yes" hint="yes" answer="no" solution="no"/>
    <exercise-project statement="yes" hint="yes" answer="no" solution="no" />
    <worksheet margin="13mm" />
    <chunking level="2" />
  </common>
  <numbering>
    <divisions chapter-start="9" />
    <projects distinct="yes" />
  </numbering>
    <webwork server="https://webwork-ptx.aimath.org"
	   course="anonymous" password="anonymous"
	   user="anonymous"/>

</publication>
